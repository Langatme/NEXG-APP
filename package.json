{
  "name": "nexg-concierge",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.ts",
    "start": "node server/index.ts",
    "db:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-postgres.ps1",
    "db:seed": "tsx scripts/seed_postgres.ts",
    "db:migrate:onboarding": "tsx scripts/migrate_onboarding.ts",
    "db:generate-sql": "python scripts/regenerate_catalog_seed.py",
    "test": "vitest run",
    "test:api": "node scripts/api-contract-test.mjs",
    "test:flow": "node scripts/v2-flow-test.mjs",
    "test:consistency": "node scripts/v3-consistency-test.mjs",
    "test:rider:ui": "node scripts/rider-browser-test.mjs",
    "staging:simulate": "node scripts/staging.mjs simulate",
    "staging:down": "node scripts/staging.mjs down",
    "staging:reset": "node scripts/staging.mjs reset",
    "shots": "node scripts/screenshots.mjs",
    "room": "node scripts/device-room/server.mjs",
    "room:check": "node scripts/device-room/check-source.mjs && node scripts/_verify-device-room.mjs",
    "devices": "node logs/critique/_device-matrix.mjs",
    "skills:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-global-skills.ps1",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.13.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-spring": "^10.0.4",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.2.3",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
